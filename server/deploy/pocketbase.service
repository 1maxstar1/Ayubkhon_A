# /etc/systemd/system/pocketbase.service
# PocketBase serves the API, the built frontend (pb_public) and obtains the
# Let's Encrypt certificate itself when started with --http and --https.
[Unit]
Description=Taqqoslash jadvali (PocketBase)
After=network.target

[Service]
Type=simple
User=pocketbase
Group=pocketbase
WorkingDirectory=/opt/taqqoslash/server
ExecStart=/opt/taqqoslash/server/pocketbase serve smeta.example.uz --http=0.0.0.0:80 --https=0.0.0.0:443 --dir=/opt/taqqoslash/server/pb_data --hooksDir=/opt/taqqoslash/server/pb_hooks --publicDir=/opt/taqqoslash/server/pb_public
Restart=always
RestartSec=5
LimitNOFILE=4096
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=PB_DEV=0

[Install]
WantedBy=multi-user.target
