# /etc/systemd/system/pocketbase.service  (installed by deploy/install.sh)
[Unit]
Description=Taqqoslash jadvali (PocketBase)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pocketbase
Group=pocketbase
WorkingDirectory=/opt/taqqoslash/server
ExecStart=/bin/sh /opt/taqqoslash/server/deploy/serve.sh
Restart=always
RestartSec=5
LimitNOFILE=4096
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=PB_DEV=0

[Install]
WantedBy=multi-user.target
