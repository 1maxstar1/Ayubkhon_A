# /opt/taqqoslash/server/.env  — created by install.sh on the first run (chmod 600).
# Edit, then on the server:  systemctl restart pocketbase && sh deploy/configure.sh

PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASS=change-me

# empty = plain http://IP ; a domain pointed at this server = automatic HTTPS
PB_DOMAIN=
APP_URL=http://0.0.0.0

# Sign-in codes go by e-mail. Gmail: smtp.gmail.com / 587 / an App password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
SENDER_ADDRESS=
SENDER_NAME="Таблица сопоставления №2"

# Fastest path when SMTP ports are blocked: an Apps Script web app in the
# sender's own Gmail account (deploy/gmail-relay.gs) — Gmail signs and sends the
# message, so it arrives in seconds. Set with deploy/gmail-relay.sh.
GMAIL_RELAY_URL=
GMAIL_RELAY_SECRET=

# Fallback: Brevo's HTTPS API (free tier, https://app.brevo.com -> SMTP & API).
# Free accounts send from a shared ...brevosend.com domain, which Gmail often
# delivers 15-20 minutes late. The sender address must be verified in Brevo.
BREVO_API_KEY=
