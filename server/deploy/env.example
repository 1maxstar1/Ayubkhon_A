# /opt/taqqoslash/server/.env  — created by install.sh on the first run (chmod 600).
# Edit, then on the server:  systemctl restart pocketbase && sh deploy/configure.sh

PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASS=change-me

# empty = plain http://IP ; a domain pointed at this server = automatic HTTPS
PB_DOMAIN=
APP_URL=http://0.0.0.0

# Sign-in codes go by e-mail. Gmail: smtp.gmail.com / 587 / an App password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
SENDER_ADDRESS=
SENDER_NAME="Taqqoslash jadvali"
